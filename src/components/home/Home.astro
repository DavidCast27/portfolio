---
import DownloadIcon from "../icons/DownloadIcon.astro";
import GitHubIcon from "../icons/GitHubIcon.astro";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
import MailIcon from "../icons/MailIcon.astro";
import Paragraph from "../ui/Paragraph.astro";
import Pill from "../ui/Pill.astro";
import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<section
  id="home"
  aria-labelledby="home-title"
  class="scroll-mt-20 pt-8 pb-16 md:pt-12 md:pb-24 flex flex-col gap-y-8 md:gap-y-10"
>
  <div
    class="flex flex-col items-center gap-4 md:flex-row md:items-center md:gap-6"
  >
    <img
      class="size-24 md:size-28 lg:size-32 rounded-full ring-1 ring-border/50 shadow-sm"
      src="https://avatars.githubusercontent.com/u/17658533?s=400&u=720a1f13ac78e3220db618daa33e15d11130747b&v=4"
      alt={i18n.home.avatar_alt}
      width="128"
      height="128"
      decoding="async"
      loading="eager"
      fetchpriority="high"
    />

    <div
      class="flex flex-col items-center text-center md:items-start md:text-left gap-3"
    >
      <h1
        id="home-title"
        class="text-display font-bold leading-tight text-balance"
      >
        {i18n.home.name}
      </h1>
      <p class="text-h2 font-medium text-foreground/85 text-pretty">
        <Fragment set:html={i18n.home.anchor} />
      </p>
    </div>
  </div>

  <Paragraph intent="lead">
    <Fragment set:html={i18n.home.lead} />
  </Paragraph>

  <p class="flex items-center gap-2 text-meta text-foreground/70">
    <span class="size-2 rounded-full bg-success" aria-hidden="true"></span>
    {i18n.home.status.label}
  </p>

  <nav
    aria-label={i18n.a11y.nav.social}
    class="flex flex-wrap gap-2 justify-center md:justify-start"
  >
    <Pill
      variant="social"
      href="https://github.com/DavidCast27"
      title="GitHub"
      aria-label="GitHub"
    >
      <GitHubIcon class="size-4" />
      <span class="hidden md:inline">{i18n.home.social.github}</span>
    </Pill>
    <Pill
      variant="social"
      href="https://www.linkedin.com/in/davidcastrillongonzales/"
      title="LinkedIn"
      aria-label="LinkedIn"
    >
      <LinkedInIcon class="size-4" />
      <span class="hidden md:inline">{i18n.home.social.linkedin}</span>
    </Pill>
    <Pill
      variant="social"
      href="mailto:david.cast27@gmail.com"
      title="email"
      aria-label="Email"
    >
      <MailIcon class="size-4" />
      <span class="hidden md:inline">{i18n.home.social.mail}</span>
    </Pill>
    <Pill
      variant="social"
      href="/CV-ES-david-castrillon.pdf"
      title="DownLoadCV"
      download
      aria-label={i18n.home.social.download_cv}
    >
      <DownloadIcon class="size-4" />
      <span class="hidden md:inline">{i18n.home.social.download_cv}</span>
    </Pill>
  </nav>
</section>
