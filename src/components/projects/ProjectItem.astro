---
import Pill from "../ui/Pill.astro";
import BoxSeamIcon from "../icons/BoxSeamIcon.astro";
import CodeIcon from "../icons/CodeIcon.astro";
import Paragraph from "../ui/Paragraph.astro";
import Button from "../ui/Button.astro";
import ListItemHeader from "../ui/ListItemHeader.astro";
import MediaFrame from "../ui/MediaFrame.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TagList from "../ui/TagList.astro";
import { getI18N } from "@/i18n";
import { Image } from "astro:assets";
import ChevronIcon from "../icons/ChevronIcon.astro";

interface Props {
  slug: string;
  title: string;
  description: string;
  tags: Array<{ name: string; className: string; Icon: any }>;
  image: any;
  codeURL: string;
  webSiteURL?: string;
}
const { slug, title, description, tags, image, codeURL, webSiteURL } =
  Astro.props;

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<article class="mb-6 md:mb-12">
  <ListItemHeader class="mb-6">
    <SectionHeading as="h3" intent="item">{title}</SectionHeading>
    <nav class="flex gap-2 md:gap-4">
      <Button
        href={codeURL}
        variant="outline"
        size="sm"
        target="_blank"
        rel="noopener noreferrer"
      >
        <CodeIcon class="size-4" />
        <span class="hidden md:inline text-xs">
          {i18n.projects.links.code}
        </span>
      </Button>
      {webSiteURL && (
        <Button
          href={webSiteURL}
          variant="outline"
          size="sm"
          target="_blank"
          rel="noopener noreferrer"
        >
          <BoxSeamIcon class="size-4" />
          <span class="hidden md:inline text-xs">
            {i18n.projects.links.web}
          </span>
        </Button>
      )}
      <Button
        href={`/${currentLocale}/projects/${slug}`}
        variant="default"
        size="sm"
        aria-label={`${i18n.projects.detail.view_more} ${title}`}
      >
        {i18n.projects.detail.view_more}
        <ChevronIcon class="size-4 ml-2" />
      </Button>
    </nav>
  </ListItemHeader>
  <Paragraph>{description}</Paragraph>
  <TagList>
    {tags.map(({ name, Icon, className }) => (
      <Pill variant="tag" class={className}>
        <Icon class="size-5" />
        <span class="hidden md:inline text-xs">{name}</span>
      </Pill>
    ))}
  </TagList>
  <MediaFrame>
    <Image
      src={image}
      alt={`${i18n.projects.image_alt_prefix} ${title}`}
      widths={[480, 768, 1024, 1440]}
      sizes="(min-width: 1024px) 768px, 100vw"
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </MediaFrame>
</article>
