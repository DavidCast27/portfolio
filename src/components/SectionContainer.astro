---
import SectionHeading from "./ui/SectionHeading.astro";
import { cn } from "@/lib/utils";

interface Props {
  id?: string;
  title?: string;
  class?: string;
}

const { id, title, class: className } = Astro.props as Props;
---

<section id={id} class={cn("scroll-mt-20 pb-12 md:pb-16", className)}>
  {title && (
    <SectionHeading as="h2" intent="section">
      <slot name="icon" />
      {title}
    </SectionHeading>
  )}
  <slot />
</section>
