---
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const badgeVariants = cva(
  "inline-flex items-center font-medium rounded border border-transparent dark:border-border",
  {
    variants: {
      color: {
        green: "bg-success text-success-foreground",
        yellow: "bg-warning text-warning-foreground",
        info: "bg-info text-info-foreground",
        destructive: "bg-destructive text-destructive-foreground",
        neutral: "bg-muted text-muted-foreground",
      },
      size: {
        sm: "text-xs px-2 py-0.5",
        md: "text-xs px-2.5 py-0.5",
      },
    },
    defaultVariants: {
      color: "neutral",
      size: "md",
    },
  }
);

type BadgeVariants = VariantProps<typeof badgeVariants>;

interface Props extends BadgeVariants {
  class?: string;
}

const { color, size, class: className } = Astro.props as Props;
const classes = cn(badgeVariants({ color, size }), className);
---

<span class={classes}>
  <slot />
</span>
