---
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const paragraphVariants = cva("text-pretty", {
  variants: {
    intent: {
      default:
        "mb-4 text-sm md:text-base lg:text-lg leading-relaxed text-foreground/90 max-w-prose",
      lead: "text-base md:text-lg lg:text-xl leading-relaxed text-foreground/95 max-w-prose",
      meta: "text-xs md:text-sm leading-relaxed text-foreground/80",
      detail:
        "text-base md:text-lg leading-relaxed text-foreground/90 max-w-prose mb-0",
    },
  },
  defaultVariants: {
    intent: "default",
  },
});

type ParagraphVariants = VariantProps<typeof paragraphVariants>;

interface Props extends ParagraphVariants {
  class?: string;
}

const { intent, class: className } = Astro.props as Props;
const classes = cn(paragraphVariants({ intent }), className);
---

<p class={classes}>
  <slot />
</p>
