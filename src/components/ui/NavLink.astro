---
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const navLinkVariants = cva(
  "inline-flex items-center rounded transition hover:bg-accent/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
  {
    variants: {
      intent: {
        primary:
          "text-sm lg:text-base px-2 py-2 hover:scale-110 aria-current:text-primary aria-current:underline aria-current:underline-offset-4",
        primaryLarge:
          "text-xl px-1 py-2 hover:scale-110 aria-current:text-primary aria-current:underline aria-current:underline-offset-4",
        muted:
          "text-xs md:text-sm lg:text-base px-3 md:px-4 min-h-11 hover:scale-110",
        menuitem:
          "w-full justify-start gap-x-2 px-3 py-2 focus:bg-accent/20 outline-none whitespace-nowrap",
      },
    },
    defaultVariants: {
      intent: "primary",
    },
  }
);

type NavLinkVariants = VariantProps<typeof navLinkVariants>;

interface Props extends NavLinkVariants {
  href: string;
  class?: string;
  role?: string;
  tabindex?: string | number;
  ["aria-label"]?: string;
}

const { intent, href, class: className, ...rest } = Astro.props as Props;
const classes = cn(navLinkVariants({ intent }), className);
---

<a class={classes} href={href} {...rest}>
  <slot />
</a>
